# Copy this file to ".env" and fill in your OWN keys.
# NEVER commit the real .env to GitHub (.gitignore already blocks it).

# Google Gemini (free tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Airtable -> https://airtable.com/create/tokens  (personal access token)
AIRTABLE_TOKEN=your-airtable-token-here
AIRTABLE_BASE_ID=your-base-id-here

# Gmail is connected inside n8n via OAuth (no key needed here).
# Owner alert address:
OWNER_EMAIL=zahidkingpk@gmail.com
